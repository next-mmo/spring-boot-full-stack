{
  "schemaVersion": 1,
  "packageManager": "npm",
  "paths": {
    "product": [
      "todo-domain/**",
      "todo-application/**",
      "todo-adapter-persistence/**",
      "todo-adapter-web/**",
      "todo-boot/**",
      "frontend/**"
    ],
    "tests": [
      "**/src/test/**",
      "frontend/**/*.test.*",
      "frontend/**/*.spec.*"
    ],
    "docs": [
      "README.md",
      "AGENT-QUICKSTART.md",
      "docs/**",
      ".agents/docs/**"
    ],
    "workflow": [
      "AGENTS.md",
      "CONTEXT.md",
      ".agents/**",
      "package.json",
      "package-lock.json"
    ],
    "ci": [
      ".github/**"
    ],
    "build": [
      "pom.xml",
      "**/pom.xml",
      "package.json",
      "package-lock.json",
      "compose.yaml",
      "Dockerfile*",
      "**/Dockerfile*"
    ]
  },
  "checks": {
    "test": "mvn test",
    "build": "mvn -DskipTests package",
    "workflow": "npm run workflow:check --"
  },
  "contextBudgets": {
    "AGENTS.md": 800,
    "CONTEXT.md": 1400
  },
  "docBudgets": {
    "AGENT-QUICKSTART.md": 2200,
    "AGENTS.md": 800,
    "CONTEXT.md": 1400,
    ".agents/docs/AGENTS.md": 900,
    ".agents/docs/architecture.md": 2000,
    ".agents/docs/development.md": 1600,
    ".agents/docs/testing.md": 1200,
    ".agents/docs/defensive-patterns.md": 1400
  },
  "ignore": [
    "**/target/**",
    "node_modules/**",
    "coverage/**",
    "dist/**",
    "**/*.min.js",
    "**/*.min.css",
    "**/*.map"
  ],
  "mode": "guided",
  "archive": {
    "autoArchiveDone": true,
    "retentionDays": 14
  }
}
